{
  "name": "backend-developer-nodejs",
  "version": "1.0.0",
  "description": "Backend developer study lab with Node.js, TypeScript, GraphQL, Hasura, and TimescaleDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext ts,tsx,json,env --signal SIGTERM --exec \"tsx src/server.ts\"",
    "dev:worker": "nodemon --watch src --watch .env --ext ts,tsx,json,env --signal SIGTERM --exec \"tsx src/worker.ts\"",
    "dev:all": "npm run dev & npm run dev:worker",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "bootstrap": "bash scripts/bootstrap.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "tsx scripts/run-case-smoke.ts",
    "lint": "tsc --noEmit -p tsconfig.test.json",
    "db:up": "docker compose up -d db hasura",
    "db:down": "docker compose down"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "backend",
    "graphql",
    "hasura",
    "timescaledb",
    "study-cases"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-graphql": "^0.12.0",
    "graphql": "^15.10.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
